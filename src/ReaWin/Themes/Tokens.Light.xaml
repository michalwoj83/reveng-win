<!-- Semantic color tokens, light theme. Views use these through DynamicResource only; never literal hex. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CanvasBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#101426" />
    <SolidColorBrush x:Key="MutedBrush" Color="#697086" />
    <SolidColorBrush x:Key="LineBrush" Color="#E1E5EF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8B93A9" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6654F5" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5140D8" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#5140D8" />
    <SolidColorBrush x:Key="TintBrush" Color="#146654F5" />
    <SolidColorBrush x:Key="FocusBrush" Color="#6654F5" />
    <SolidColorBrush x:Key="LiveBrush" Color="#0E8FA0" />
    <SolidColorBrush x:Key="OkBrush" Color="#12805C" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#1A12805C" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#1A8A5A00" />
    <SolidColorBrush x:Key="ErrBrush" Color="#C0263F" />
    <SolidColorBrush x:Key="ErrBgBrush" Color="#14C0263F" />
</ResourceDictionary>
