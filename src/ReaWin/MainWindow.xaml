<Window x:Class="ReaWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REA for Windows" Height="760" Width="1280" MinHeight="520" MinWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Choose an application directory -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button x:Name="BrowseButton" DockPanel.Dock="Left" Content="Select app folder…" Padding="12,5" Click="Browse_Click" />
            <Button x:Name="RescanButton" DockPanel.Dock="Right" Content="Rescan" Padding="12,5" Margin="8,0,0,0" Click="Rescan_Click" IsEnabled="False" />
            <TextBox x:Name="FolderBox" Margin="8,0,0,0" VerticalContentAlignment="Center" IsReadOnly="True" />
        </DockPanel>

        <Expander Grid.Row="1" Header="REA / Ghidra settings" Margin="0,8,0,0">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="GHIDRA_INSTALL_DIR" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="GhidraBox" Margin="0,2" />
                <TextBlock Grid.Row="1" Text="JAVA_HOME (JDK 21+)" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="JavaBox" Margin="0,2" />
                <TextBlock Grid.Row="2" Text="rea.mjs path" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReaBox" Margin="0,2" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Run rea doctor" Padding="10,3" Click="Doctor_Click" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                               Text="Values apply to REA child processes only; nothing is written to your environment." />
                </StackPanel>
            </Grid>
        </Expander>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- 2. Detected binaries -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Binaries" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="HideHelpersBox" Content="Hide helpers and runtime libraries" Margin="14,0,0,0"
                              IsChecked="True" VerticalAlignment="Center" Click="Filter_Changed" />
                    <TextBlock x:Name="CountText" Margin="14,0,0,0" Foreground="Gray" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="BannerText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"
                           Background="#FFFFF4CE" Padding="8" Visibility="Collapsed" />
                <DataGrid x:Name="BinariesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionChanged="Binaries_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="50" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="48" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150" />
                        <DataGridTextColumn Header="UI" Binding="{Binding Subsystem}" Width="90" />
                        <DataGridTextColumn Header="Arch" Binding="{Binding Machine}" Width="70" />
                        <DataGridTextColumn Header="" Binding="{Binding Managed}" Width="50" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" />
                        <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" />
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Recommended}" Value="True">
                                    <Setter Property="Background" Value="#FFE3F4E1" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LikelyHelper}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- 3. Run REA and show results -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="AnalyzeButton" Content="Analyze selected with REA + Ghidra" Padding="12,5"
                            Click="Analyze_Click" IsEnabled="False" />
                    <Button x:Name="AnalyzeRecommendedButton" Content="Analyze recommended" Padding="12,5" Margin="8,0,0,0"
                            Click="AnalyzeRecommended_Click" IsEnabled="False" />
                    <Button x:Name="JsButton" Content="Analyze as JavaScript app" Padding="12,5" Margin="8,0,0,0"
                            Click="Js_Click" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Content="Cancel" Padding="12,5" Margin="8,0,0,0"
                            Click="Cancel_Click" IsEnabled="False" />
                </StackPanel>

                <TabControl x:Name="Tabs">
                    <TabItem Header="Why this file">
                        <TextBox x:Name="WhyBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="8" BorderThickness="0" />
                    </TabItem>
                    <TabItem Header="Overview">
                        <TextBox x:Name="OverviewBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Padding="8" BorderThickness="0" />
                    </TabItem>
                    <TabItem Header="Functions">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Filter:" VerticalAlignment="Center" />
                                <TextBox x:Name="FuncFilterBox" Width="200" Margin="6,0" TextChanged="FuncFilter_Changed" />
                                <CheckBox x:Name="InternalOnlyBox" Content="Program functions only" IsChecked="True"
                                          VerticalAlignment="Center" Click="FuncFilter_Click" />
                                <Button Content="Decompile selected" Margin="12,0,0,0" Padding="10,3" Click="Decompile_Click" />
                            </StackPanel>
                            <DataGrid x:Name="FunctionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                      MouseDoubleClick="Functions_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Strings">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6">
                                <TextBlock Text="Filter:" VerticalAlignment="Center" />
                                <TextBox x:Name="StrFilterBox" Width="240" Margin="6,0" TextChanged="StrFilter_Changed" />
                            </StackPanel>
                            <DataGrid x:Name="StringsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Decompiled">
                        <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8" BorderThickness="0" />
                    </TabItem>
                    <TabItem Header="Log">
                        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="8" BorderThickness="0" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Select an application folder to begin." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="Busy" Width="160" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
