<Window xmlns:local="clr-namespace:ReaWin" x:Class="ReaWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reverse.Engineer.AI" Height="800" Width="1320" MinHeight="560" MinWidth="980"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: product name, state of the analysis engine, settings -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,0" Height="56">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="16" FontWeight="Bold">
                    <Run Text="Reverse" /><Run Text="." Foreground="{DynamicResource AccentTextBrush}" /><Run Text="Engineer" /><Run Text="." Foreground="{DynamicResource AccentTextBrush}" /><Run Text="AI" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Content="About" Click="About_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="About Reverse.Engineer.AI" />
                <Button DockPanel.Dock="Right" Content="Settings" Click="Settings_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Open settings" />
                <Button DockPanel.Dock="Right" Content="Run rea doctor" Click="Doctor_Click" Style="{StaticResource TextButton}"
                        Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="StatusChip" DockPanel.Dock="Right" CornerRadius="13" Height="26" Padding="10,0" VerticalAlignment="Center"
                        Background="{DynamicResource OkBgBrush}" AutomationProperties.LiveSetting="Polite">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusChipGlyph" Text="✓" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource OkBrush}" />
                        <TextBlock x:Name="StatusChipText" Text="Ghidra ready" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource OkBrush}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 1. Choose an application directory -->
        <DockPanel Grid.Row="1" Margin="12,12,12,0" LastChildFill="True">
            <Button x:Name="PanelToggleButton" DockPanel.Dock="Left" Content="◀ Hide list" Style="{StaticResource TextButton}" Margin="0,0,8,0" Click="PanelToggle_Click"
                    ToolTip="Hide or show the list of binaries and projects (Ctrl+B). While it is hidden the workspace uses the whole width."
                    AutomationProperties.Name="Hide or show the binaries and projects list" />
            <Button x:Name="BrowseButton" DockPanel.Dock="Left" Content="Select app folder…" Click="Browse_Click" />
            <Button x:Name="RescanButton" DockPanel.Dock="Right" Content="Rescan" Margin="8,0,0,0" Click="Rescan_Click" IsEnabled="False" />
            <TextBox x:Name="FolderBox" Margin="8,0,0,0" IsReadOnly="True" AutomationProperties.Name="Selected folder" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="4*" MinWidth="330" />
                <ColumnDefinition x:Name="PanelSplitterColumn" Width="12" />
                <ColumnDefinition x:Name="WorkspaceColumn" Width="6*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- 2. What to analyze: detected binaries and stored projects. Can be hidden (the button in the folder row, Ctrl+B). -->
            <Border x:Name="LeftPane" Grid.Column="0" Style="{StaticResource Pane}">
                <TabControl x:Name="LeftTabs">
                    <TabItem Header="Binaries">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="HideHelpersBox" Content="Hide helpers and runtime libraries" IsChecked="True"
                                          VerticalAlignment="Center" Click="Filter_Changed" />
                                <TextBlock x:Name="CountText" Margin="14,0,0,0" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="BannerBox" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,10"
                                    CornerRadius="10" BorderThickness="1" Background="{DynamicResource WarnBgBrush}"
                                    BorderBrush="{DynamicResource WarnBrush}">
                                <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="AnalyzeButton" Content="Analyze selected" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0" Click="Analyze_Click" IsEnabled="False" />
                                <Button x:Name="AnalyzeRecommendedButton" Content="Analyze recommended" Margin="0,0,8,0"
                                        Click="AnalyzeRecommended_Click" IsEnabled="False" />
                                <Button x:Name="JsButton" Content="Analyze as JavaScript app" Click="Js_Click" Visibility="Collapsed" />
                            </WrapPanel>
                            <DataGrid x:Name="BinariesGrid" AutoGenerateColumns="False" SelectionChanged="Binaries_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                                    <DataGridTemplateColumn Header="Hint" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}"
                                                        Visibility="{Binding Recommended, Converter={StaticResource BoolToVisible}}"
                                                        ToolTip="A heuristic from PE headers and file names, not a fact. See the reasons in Why this file.">
                                                    <TextBlock Text="Hint" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="50" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="48" />
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150" />
                                    <DataGridTextColumn Header="UI" Binding="{Binding Subsystem}" Width="90" />
                                    <DataGridTextColumn Header="Arch" Binding="{Binding Machine}" Width="70" />
                                    <DataGridTextColumn Header="" Binding="{Binding Managed}" Width="50" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" />
                                    <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" />
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Recommended}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LikelyHelper}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Analyses are stored automatically; pick one to continue where you left off. -->
                    <TabItem x:Name="ProjectsTab" Header="Projects">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="DeleteProjectButton" Content="Delete selected" Margin="0,0,8,0"
                                        Click="DeleteProject_Click" IsEnabled="False" />
                                <Button x:Name="OpenProjectButton" Content="Open file…" Style="{StaticResource TextButton}" Click="OpenProject_Click"
                                        ToolTip="Open a .reaproj file from anywhere (it is then added to Projects)." />
                                <Button x:Name="SaveProjectButton" Content="Export…" Style="{StaticResource TextButton}" Click="SaveProject_Click" IsEnabled="False"
                                        ToolTip="Copy the current project to a .reaproj file of your choice. Projects are also stored automatically." />
                            </WrapPanel>
                            <TextBlock x:Name="ProjectsHint" DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ListBox x:Name="ProjectsList" SelectionChanged="Projects_SelectionChanged" AutomationProperties.Name="Stored projects">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding TargetPath}" Style="{StaticResource CaptionText}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ToolTip="Drag to make the list wider or narrower" />

            <!-- 3. What was found -->
            <Border Grid.Column="2" Style="{StaticResource Pane}">
                <Grid>
                    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                        <TabItem Header="Why this file">
                            <TextBox x:Name="WhyBox" Style="{StaticResource ReadingBox}" TextWrapping="Wrap" />
                        </TabItem>
                        <TabItem x:Name="OverviewTab" Header="Overview">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource Pill}" Background="Transparent" BorderThickness="1"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            ToolTip="What REA reported from the file. Nothing on this tab is inferred by this app.">
                                        <TextBlock Text="Observed · REA" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" />
                                    </Border>
                                </StackPanel>
                                <TextBox x:Name="OverviewBox" Style="{StaticResource CodeBox}" TextWrapping="Wrap" Padding="0" />
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="FunctionsTab" Header="Functions">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Filter" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="FuncFilterBox" Width="220" TextChanged="FuncFilter_Changed"
                                             AutomationProperties.Name="Filter functions by name or address" />
                                    <CheckBox x:Name="InternalOnlyBox" Content="Program functions only" IsChecked="True"
                                              Margin="14,0,0,0" VerticalAlignment="Center" Click="FuncFilter_Click" />
                                </StackPanel>
                                <!-- Select a function and its code appears beside the list. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" MinWidth="220" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="5*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid Grid.Column="0" x:Name="FunctionsGrid" AutoGenerateColumns="False"
                                              SelectionChanged="Functions_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="104" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn x:Name="AliasColumn" Header="AI name" Width="150" IsReadOnly="True" CanUserSort="False">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                        <Setter Property="ToolTip" Value="The readable name the local AI gave the function when it was explained. REA's own name stays in the Name column." />
                                                    </Style>
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="76" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition x:Name="CodeRow" Height="*" MinHeight="120" />
                                            <!-- 0 while there is no description; MainWindow.Ai.cs gives the panel 4 parts to the code's 5 -->
                                            <RowDefinition x:Name="AiRow" Height="0" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,2,0,8">
                                            <!-- only for a function that has an alias; the alias is an inference, the decompiled code is what REA reported -->
                                            <StackPanel DockPanel.Dock="Right" x:Name="CodeViewPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                                <Border x:Name="CodeAliasTag" Style="{StaticResource Pill}" Background="Transparent" BorderThickness="1"
                                                        BorderBrush="{DynamicResource WarnBrush}" Visibility="Collapsed" Margin="0,0,10,0"
                                                        ToolTip="Written by the local model: the same code as the decompiled version with readable names and comments. The app compared them token by token; only names and comments differ.">
                                                    <TextBlock Text="Inference · AI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
                                                </Border>
                                                <RadioButton x:Name="CodeViewOriginal" Content="Decompiled" GroupName="CodeView" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                                             Click="CodeView_Click" ToolTip="The code exactly as REA and Ghidra returned it." />
                                                <RadioButton x:Name="CodeViewAlias" Content="Alias" GroupName="CodeView" VerticalAlignment="Center" Click="CodeView_Click"
                                                             ToolTip="The same code with readable variable and function names and comments, written by the local AI and checked against the original." />
                                            </StackPanel>
                                            <TextBlock x:Name="CodeHeader" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Text="Select a function to see its decompiled code." />
                                        </DockPanel>
                                        <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                                Background="{DynamicResource CanvasBrush}">
                                            <TextBox x:Name="CodeBox" Style="{StaticResource CodeBox}" AutomationProperties.Name="Decompiled code" />
                                        </Border>

                                        <!-- The model's description: an inference, tagged as one and kept apart from REA's code above. -->
                                        <Border Grid.Row="2" x:Name="AiPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8"
                                                CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                                Background="{DynamicResource SurfaceBrush}">
                                            <DockPanel>
                                                <!-- tag on the left, actions on the right: one row, so the text below gets the room -->
                                                <DockPanel DockPanel.Dock="Top">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button x:Name="AiContextButton" Content="Show context" Style="{StaticResource TextButton}" MinHeight="26"
                                                                Padding="10,0" Click="AiContext_Click" Visibility="Collapsed"
                                                                ToolTip="What the model was told about the function's callers and callees besides the code." />
                                                        <Button x:Name="AiCopyButton" Content="Copy" Style="{StaticResource TextButton}" MinHeight="26"
                                                                Padding="10,0" Click="AiCopy_Click" />
                                                        <Button x:Name="AiDiscardButton" Content="Discard" Style="{StaticResource TextButton}" MinHeight="26"
                                                                Padding="10,0" Click="AiDiscard_Click"
                                                                ToolTip="Remove this description from the project. The code is not affected." />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border x:Name="AiTag" Style="{StaticResource Pill}" Background="Transparent" BorderThickness="1"
                                                                BorderBrush="{DynamicResource WarnBrush}"
                                                                ToolTip="The model's reading of the code, not something REA observed.">
                                                            <TextBlock Text="Inference · AI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
                                                        </Border>
                                                        <TextBlock x:Name="AiState" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock x:Name="AiNote" DockPanel.Dock="Top" Margin="0,4,0,6" Style="{StaticResource CaptionText}" />
                                                <!-- the context the description was written from: observed facts and the AI's own notes on neighbours -->
                                                <DockPanel x:Name="AiContextPanel" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                                                    <Button x:Name="AiForgetButton" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Style="{StaticResource TextButton}"
                                                            MinHeight="26" Padding="0,0,10,0" Content="Forget the neighbour summaries used here" Click="AiForget_Click"
                                                            ToolTip="Removes the AI's one-line notes on the neighbouring functions, so the next Explain writes them again." />
                                                    <TextBox x:Name="AiContextText" Style="{StaticResource ReadingBox}" TextWrapping="Wrap" MaxHeight="150"
                                                             AutomationProperties.Name="Context given to the AI" />
                                                </DockPanel>
                                                <TextBox x:Name="AiText" Style="{StaticResource ReadingBox}" TextWrapping="Wrap"
                                                         AutomationProperties.Name="AI description of the function" />
                                            </DockPanel>
                                        </Border>

                                        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
                                            <Button DockPanel.Dock="Left" x:Name="ExplainButton" ToolTipService.ShowOnDisabled="True" Content="Explain" Style="{StaticResource TonalButton}" IsEnabled="False"
                                                    Margin="0,0,8,0" Click="Explain_Click" />
                                            <Button DockPanel.Dock="Left" x:Name="AiStopButton" Content="Stop" Style="{StaticResource TextButton}" MinHeight="28"
                                                    Visibility="Collapsed" Margin="0,0,8,0" Click="AiStop_Click" />
                                            <Button DockPanel.Dock="Left" x:Name="AliasButton" ToolTipService.ShowOnDisabled="True" Content="Write alias code" Style="{StaticResource TextButton}" MinHeight="28"
                                                    IsEnabled="False" Margin="0,0,8,0" Click="AliasButton_Click" />
                                            <Button DockPanel.Dock="Left" x:Name="ShowInGraphButton" ToolTipService.ShowOnDisabled="True" Content="Show in graph" Style="{StaticResource TextButton}" MinHeight="28"
                                                    IsEnabled="False" Margin="0,0,8,0" Click="ShowInGraph_Click"
                                                    ToolTip="Open this function in the Graph tab: who calls it and what it calls." />
                                            <TextBlock x:Name="AiHint" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="GraphTab" Header="Graph">
                            <DockPanel>
                                <!-- Focus, history, search and what to show. Wraps on a narrow window. -->
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button x:Name="GraphBackButton" Content="◀" Style="{StaticResource TextButton}" MinHeight="28" Padding="10,0" Margin="0,0,2,0"
                                            IsEnabled="False" Click="GraphBack_Click" ToolTip="Back to the previous focus" AutomationProperties.Name="Back" />
                                    <Button x:Name="GraphForwardButton" Content="▶" Style="{StaticResource TextButton}" MinHeight="28" Padding="10,0" Margin="0,0,10,0"
                                            IsEnabled="False" Click="GraphForward_Click" ToolTip="Forward" AutomationProperties.Name="Forward" />
                                    <TextBlock x:Name="GraphFocusText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="320"
                                               TextTrimming="CharacterEllipsis" Text="No function" ToolTip="The focus: the function the graph is centered on, with its address. Callers are drawn to its left, callees to its right."/>
                                    <TextBox x:Name="GraphFindBox" Width="190" Margin="0,0,14,0" KeyDown="GraphFind_KeyDown"
                                             ToolTip="Find a function and make it the focus. Type part of a name or a whole address and press Enter. Only program functions are searched." AutomationProperties.Name="Find a function to focus" />
                                    <TextBlock Text="Depth" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="How many calls away from the focus to draw. Each step adds a column on each side." />
                                    <RadioButton x:Name="GraphDepth1" Content="1" GroupName="GraphDepth" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Direct callers and direct callees only. The most readable view."/>
                                    <RadioButton x:Name="GraphDepth2" Content="2" GroupName="GraphDepth" Margin="0,0,8,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Two calls away: callers of callers and callees of callees."/>
                                    <RadioButton x:Name="GraphDepth3" Content="3" GroupName="GraphDepth" Margin="0,0,14,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Three calls away. Wide: best on a function with few neighbours."/>
                                    <TextBlock Text="Show" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Which side of the focus to draw." />
                                    <RadioButton x:Name="GraphBoth" Content="Both" GroupName="GraphDirection" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Callers on the left and callees on the right."/>
                                    <RadioButton x:Name="GraphCallersOnly" Content="Callers" GroupName="GraphDirection" Margin="0,0,8,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Only the functions that call the focus: who uses it, and from where."/>
                                    <RadioButton x:Name="GraphCalleesOnly" Content="Callees" GroupName="GraphDirection" Margin="0,0,14,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Only the functions the focus calls: what it relies on."/>
                                    <CheckBox x:Name="GraphLibraryBox" Content="Library &amp; runtime" Margin="0,0,12,0" VerticalAlignment="Center" Click="GraphOptions_Changed"
                                              ToolTip="Show functions Ghidra matched to a known library (the C runtime and the like). Hidden by default because they are called from everywhere and bury the program own code. Hidden ones are counted in the line below the graph." />
                                    <CheckBox x:Name="GraphImportsBox" Content="Imports" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Click="GraphOptions_Changed" ToolTip="Show the Windows and library functions the focus calls (KERNEL32, USER32 and so on) as small chips. They have no code in this file and are never followed further."/>
                                    <CheckBox x:Name="GraphHubsBox" Content="Hubs" Margin="0,0,12,0" VerticalAlignment="Center" Click="GraphOptions_Changed"
                                              ToolTip="Follow calls through hubs: functions with more than 30 callers and callees, such as allocation or error helpers. Off by default: a hub next to the focus is still shown, but nothing is drawn beyond it, so one helper cannot pull in half the program." />
                                    <Button x:Name="GraphFitButton" Content="Fit" Style="{StaticResource TextButton}" MinHeight="28" Padding="10,0" Click="GraphFit_Click"
                                            ToolTip="Fit the picture in the window again, centered on the focus (Home). Dragging and scrolling change the view; this resets it." />
                                    <Button x:Name="GraphGuideButton" Content="Guide" Style="{StaticResource TextButton}" MinHeight="28" Padding="10,0" Margin="4,0,0,0"
                                            Click="GraphGuide_Click" ToolTip="A short guide to reading and exploring the graph" />
                                </WrapPanel>

                                <TextBlock DockPanel.Dock="Bottom" x:Name="GraphStatus" Margin="2,8,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" ToolTip="What is shown and what is left out: hidden library functions, collapsed hubs, nodes behind +N more. Nothing disappears without being counted here."/>

                                <!-- the short guide, built from GraphGuide in MainWindow.Graph.cs; opens by itself while there is no focus -->
                                <Border DockPanel.Dock="Top" x:Name="GraphGuidePanel" Style="{StaticResource Pane}" Padding="14,10" Margin="0,0,0,8" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Hide" Style="{StaticResource TextButton}" MinHeight="26" Padding="10,0" VerticalAlignment="Top"
                                                Click="GraphGuide_Click" />
                                        <StackPanel x:Name="GraphGuideBody" />
                                    </DockPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="300" MinWidth="220" MaxWidth="480" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Pane}" Background="{DynamicResource CanvasBrush}" CornerRadius="10">
                                        <Grid>
                                            <local:GraphCanvas x:Name="GraphView" AutomationProperties.Name="Call graph"
                                                               AutomationProperties.HelpText="Callers on the left, the focused function in the middle, callees on the right. Arrow keys move between nodes, Enter makes a node the focus. The list on the right holds the same neighbours." />
                                            <!-- shown instead of the picture when there is nothing to draw -->
                                            <StackPanel x:Name="GraphEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                                                <TextBlock x:Name="GraphEmptyTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock x:Name="GraphEmptyText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                                <Button x:Name="GraphEmptyAction" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                        Visibility="Collapsed" Click="GraphEmptyAction_Click" />
                                                <TextBlock x:Name="GraphStartLabel" Text="Start from" Style="{StaticResource MutedText}" FontWeight="Medium" Margin="0,14,0,4" Visibility="Collapsed" />
                                                <ListBox x:Name="GraphStartList" MaxHeight="190" Visibility="Collapsed" MouseDoubleClick="GraphStartList_DoubleClick"
                                                         KeyDown="GraphStartList_KeyDown" AutomationProperties.Name="Functions to start the graph from" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                                    <!-- the selected node: observed facts, the AI note if there is one, what can be done with it, its neighbours -->
                                    <Border Grid.Column="2" Style="{StaticResource Pane}" Padding="12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" x:Name="GraphNodeName" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Text="Nothing selected" ToolTip="The selected node. Click a node in the graph, or an entry in the list below, to select it."/>
                                            <TextBlock DockPanel.Dock="Top" x:Name="GraphNodeAddress" Style="{StaticResource CaptionText}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,6" ToolTip="The address exactly as REA reports it."/>
                                            <StackPanel DockPanel.Dock="Top" x:Name="GraphNodeDetails" Visibility="Collapsed">
                                                <Border Style="{StaticResource Pill}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                                        ToolTip="Facts from REA and Ghidra; nothing here is inferred by this app or the AI.">
                                                    <TextBlock Text="Observed · REA" FontSize="11" FontWeight="SemiBold" Style="{StaticResource MutedText}" />
                                                </Border>
                                                <TextBlock x:Name="GraphNodeFacts" Style="{StaticResource CaptionText}" Margin="0,6,0,0" ToolTip="What REA and Ghidra report about this function: what kind it is, how many functions call it and how many it calls."/>
                                                <StackPanel x:Name="GraphNodeAi" Margin="0,10,0,0" Visibility="Collapsed">
                                                    <Border Style="{StaticResource Pill}" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource WarnBrush}"
                                                            ToolTip="The model note about this function, not something REA observed.">
                                                        <TextBlock Text="Inference · AI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
                                                    </Border>
                                                    <TextBlock x:Name="GraphNodeAiText" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <!-- What can be done with the node. Filled from the list of graph actions in MainWindow.Graph.cs. -->
                                                <WrapPanel x:Name="GraphActionsPanel" Margin="0,12,0,0" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Top" x:Name="GraphNeighboursLabel" Text="Neighbours" Style="{StaticResource MutedText}" FontWeight="Medium"
                                                       Margin="0,12,0,4" Visibility="Collapsed" ToolTip="The same neighbours as the graph, as a list. Reachable with the keyboard and by screen readers."/>
                                            <ListBox x:Name="GraphNeighbours" Visibility="Collapsed" MouseDoubleClick="GraphNeighbours_DoubleClick" KeyDown="GraphNeighbours_KeyDown"
                                                     AutomationProperties.Name="Neighbours of the selected function" ToolTip="Every caller and callee of the selected function, also those not drawn. Double-click or press Enter to make one the focus."/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Strings">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Filter" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="StrFilterBox" Width="260" TextChanged="StrFilter_Changed"
                                             AutomationProperties.Name="Filter strings" />
                                </StackPanel>
                                <DataGrid x:Name="StringsGrid" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="LogTab" Header="Log">
                            <TextBox x:Name="LogBox" Style="{StaticResource CodeBox}" TextWrapping="Wrap" Padding="0" FontSize="12" />
                        </TabItem>
                    </TabControl>

                    <!-- Covers the result tabs (not the tab strip) while there is nothing to show. -->
                    <Border x:Name="EmptyState" Margin="1,41,1,1" CornerRadius="0,0,11,11" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="460" Margin="32,0">
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyBody" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <ProgressBar x:Name="EmptyBar" IsIndeterminate="True" Margin="0,16,0,0" Width="180" HorizontalAlignment="Left"
                                         Visibility="Collapsed" AutomationProperties.Name="Analyzing" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="EmptyPrimary" Style="{StaticResource PrimaryButton}" Click="EmptyPrimary_Click" />
                                <Button x:Name="EmptySecondary" Margin="8,0,0,0" Click="EmptySecondary_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusText" Text="Select an application folder to begin." TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="BulkPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                        <TextBlock x:Name="BulkText" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}" />
                        <ProgressBar x:Name="BulkBar" Width="140" Height="6" AutomationProperties.Name="Decompile progress" />
                    </StackPanel>
                    <ProgressBar x:Name="Busy" Width="140" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"
                                 AutomationProperties.Name="Working" />
                    <Button x:Name="CancelButton" Content="Cancel" MinHeight="26" Padding="12,0" Click="Cancel_Click" IsEnabled="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <!-- Nothing to cancel: no button, instead of a dead one. -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
