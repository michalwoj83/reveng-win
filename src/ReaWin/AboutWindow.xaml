<Window x:Class="ReaWin.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Reverse.Engineer.AI" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <!-- Content scrolls on a small screen; Close stays in view. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,0">
                <Image x:Name="LogoImage" Height="36" HorizontalAlignment="Left" Stretch="Uniform"
                       AutomationProperties.Name="Ai.Slop.AI" />

                <TextBlock Margin="0,16,0,0" FontSize="20" FontWeight="Bold">
                    <Run Text="Reverse" /><Run Text="." Foreground="{DynamicResource AccentTextBrush}" /><Run Text="Engineer" /><Run Text="." Foreground="{DynamicResource AccentTextBrush}" /><Run Text="AI" />
                </TextBlock>
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />

                <!-- Brand manifest, shortened. -->
                <TextBlock Margin="0,18,0,0" Text="AI-native. Not cloud-native." FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="We don't add AI to software. We build software around AI. Local models, embedded intelligence: the programs you study and what you learn about them stay on your computer." />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Yes, it's called Ai.Slop.AI. We know. That's the point: there is enough AI slop already, so we make ours useful." />

                <Border Margin="0,18,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="How it works" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="This app is a thin front end. Ghidra, driven through REA, does the disassembly and decompiling. The programs you open are read and analyzed, never run." />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="What REA and Ghidra report is marked as observed. Anything the AI writes is marked as inference, is kept apart, and can be wrong: check it against the code." />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Credits" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="REA, the local reverse-engineering server this app drives (github.com/morluto/rea)." />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="Ghidra, the software reverse engineering framework from the NSA Research Directorate, Apache-2.0 licence." />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="Ternary Bonsai 2 27B (the optional local AI) by PrismML, Apache-2.0 licence." />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}"
                                   Text="The model runs through PrismML's build of llama.cpp (MIT licence). Thank you to everyone who built and shared these." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,20">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" MinWidth="84" />
        </StackPanel>
    </Grid>
</Window>
