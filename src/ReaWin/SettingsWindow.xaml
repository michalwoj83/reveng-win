<Window x:Class="ReaWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REA settings" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ghidra -->
        <TextBlock Grid.Row="0" Text="Ghidra install folder (GHIDRA_INSTALL_DIR)" FontWeight="SemiBold" />
        <DockPanel Grid.Row="1" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3" Margin="8,0,0,0" Click="BrowseGhidra_Click" />
            <TextBox x:Name="GhidraBox" TextChanged="GhidraBox_TextChanged" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="GhidraStatus" Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- Java -->
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="Java (JAVA_HOME, JDK 21 or newer, 64-bit)" FontWeight="SemiBold" />
        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3" Margin="8,0,0,0" Click="BrowseJava_Click" />
            <Button DockPanel.Dock="Right" Content="Rescan" Padding="12,3" Margin="8,0,0,0" Click="RescanJava_Click" />
            <ComboBox x:Name="JavaCombo" DisplayMemberPath="Display" SelectionChanged="JavaCombo_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </DockPanel>
        <TextBlock x:Name="JavaStatus" Grid.Row="5" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- rea.mjs + buttons -->
        <StackPanel Grid.Row="6" Margin="0,16,0,0">
            <TextBlock Text="rea.mjs path" FontWeight="SemiBold" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,3" Margin="8,0,0,0" Click="BrowseRea_Click" />
                <TextBox x:Name="ReaBox" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="Values apply to REA child processes only; nothing is written to your environment." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="OK" Width="80" Padding="0,4" IsDefault="True" Click="Ok_Click" />
                <Button Content="Cancel" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
