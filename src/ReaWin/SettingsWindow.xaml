<Window x:Class="ReaWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="780" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="20">

        <!-- Ghidra -->
        <TextBlock Text="Ghidra install folder" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Medium" />
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseGhidra_Click" />
            <TextBox x:Name="GhidraBox" TextChanged="GhidraBox_TextChanged" AutomationProperties.Name="Ghidra install folder" />
        </DockPanel>
        <TextBlock x:Name="GhidraStatus" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />

        <!-- Java -->
        <TextBlock Margin="0,18,0,0" Text="Java (JDK 21 or newer, 64-bit)" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Medium" />
        <Border Margin="0,4,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="10"
                Background="{DynamicResource SurfaceBrush}" Padding="2" ClipToBounds="True">
            <ListBox x:Name="JavaCombo" DisplayMemberPath="Display" MaxHeight="150" SelectionChanged="JavaCombo_SelectionChanged"
                     AutomationProperties.Name="Detected JDKs">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
        <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Rescan" Click="RescanJava_Click" Style="{StaticResource TextButton}" />
                <Button Content="Browse…" Click="BrowseJava_Click" Style="{StaticResource TextButton}" />
            </StackPanel>
            <TextBlock x:Name="JavaStatus" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>

        <!-- rea.mjs -->
        <TextBlock Margin="0,18,0,0" Text="rea.mjs path" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Medium" />
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseRea_Click" />
            <TextBox x:Name="ReaBox" AutomationProperties.Name="rea.mjs path" />
        </DockPanel>

        <!-- Appearance -->
        <TextBlock Margin="0,18,0,0" Text="Appearance" Style="{StaticResource MutedText}" FontSize="12" FontWeight="Medium" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="ThemeSystemRadio" GroupName="Theme" Content="Follow Windows" Margin="0,0,20,0" />
            <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Content="Light" Margin="0,0,20,0" />
            <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Content="Dark" />
        </StackPanel>

        <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionText}"
                   Text="Values apply to REA child processes only; nothing is written to your environment." />

        <!-- About -->
        <Border Margin="0,16,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Reverse.Engineer.AI" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" Text="A tool by Ai.Slop.AI · analysis by REA and Ghidra" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" />
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="84" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
