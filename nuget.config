<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="aislop" value="https://nuget.pkg.github.com/michalwoj83/index.json" />
  </packageSources>
  <!-- AiSlop.* comes only from the private feed; everything else only from nuget.org. See the aislop-nuget-packages skill. -->
  <packageSourceMapping>
    <packageSource key="aislop"><package pattern="AiSlop.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
